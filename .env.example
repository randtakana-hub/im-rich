# PostgreSQL connection string
# Local docker-compose default (see docker-compose.yml):
DATABASE_URL="postgresql://imrich:imrich@localhost:5432/imrich?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Payments — set USE_TEST_PAYMENTS=true to run the safe development
# payment mode (no real charges, instant "webhook" confirmation).
# Flip to false and fill in Stripe keys for production.
USE_TEST_PAYMENTS="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
