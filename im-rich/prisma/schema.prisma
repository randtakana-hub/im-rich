generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  fullName      String
  passwordHash  String
  isAdmin       Boolean   @default(false)
  isSuspended   Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile Profile?
  wallet  Wallet?

  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")

  friendshipsAsA Friendship[] @relation("FriendA")
  friendshipsAsB Friendship[] @relation("FriendB")

  sentTransactions     RichCoinTransaction[] @relation("SenderTx")
  receivedTransactions RichCoinTransaction[] @relation("ReceiverTx")

  payments      Payment[]
  notifications Notification[]

  auditLogsPerformed AuditLog[] @relation("AdminActor")
  auditLogsReceived  AuditLog[] @relation("AuditTarget")

  @@index([username])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarSeed String  // used to derive a generated avatar; no external upload required
  bio       String?
  updatedAt DateTime @updatedAt
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int      @default(0) // integer RC, never floating point
  totalPurchased Int      @default(0)
  totalSent      Int      @default(0)
  totalReceived  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Social graph
// ─────────────────────────────────────────────────────────────

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  sender     User                @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Always stored with userAId < userBId (enforced in application code)
  // so a pair only ever exists once.
  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ─────────────────────────────────────────────────────────────
// Rich Coin ledger
// ─────────────────────────────────────────────────────────────

enum TransactionType {
  SEND
  RECEIVE
  PURCHASE
  ADMIN_ADJUST
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model RichCoinTransaction {
  id         String            @id @default(cuid())
  senderId   String?
  receiverId String?
  sender     User?             @relation("SenderTx", fields: [senderId], references: [id])
  receiver   User?             @relation("ReceiverTx", fields: [receiverId], references: [id])
  amount     Int
  type       TransactionType
  status     TransactionStatus @default(COMPLETED)
  // idempotency key: prevents the same client-submitted transfer from
  // ever being applied twice, even under retries / double taps.
  clientRequestId String?       @unique
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  package           String // e.g. "250_RC"
  rcAmount          Int
  amountPaidCents   Int
  currency          String        @default("usd")
  paymentProvider   String        @default("stripe")
  // Stripe checkout session id (or test-mode equivalent). Unique so a
  // replayed webhook can never credit RC a second time.
  providerPaymentId String        @unique
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  RC_RECEIVED
  RC_SENT
  PURCHASE_COMPLETED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────────────────────
// Admin / audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AdminActor", fields: [adminId], references: [id])
  targetUserId String
  target       User     @relation("AuditTarget", fields: [targetUserId], references: [id])
  amount       Int
  reason       String
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
